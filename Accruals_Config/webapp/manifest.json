{
	"_version": "1.12.0",
	"sap.app": {
		"id": "com.takeda.Accrual_UI5.Accrual_Ctry",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"sourceTemplate": {
			"id": "servicecatalog.connectivityComponentForManifest",
			"version": "0.0.0"
		},
		"dataSources": {
			"readConfigValues.xsodata": {
				"uri": "/XSA_HTTP_ACCRUAL/xsodata/readConfigValues.xsodata/",
				"type": "OData",
				"settings": {
					"localUri": "localService/readConfigValues.xsodata/metadata.xml"
				}
			},
			"userRole.xsodata": {
				"uri": "/XSA_HTTP_ACCRUAL/xsodata/userRole.xsodata/",
				"type": "OData",
				"settings": {
					"localUri": "localService/userRole.xsodata/metadata.xml"
				}
			},
			"readThreshold.xsodata": {
				"uri": "/XSA_HTTP_ACCRUAL/xsodata/readThreshold.xsodata/",
				"type": "OData",
				"settings": {
					"localUri": "localService/readThreshold.xsodata/metadata.xml"
				}
			},
			"readCtryConfig.xsodata": {
				"uri": "/XSA_HTTP_ACCRUAL/xsodata/readCtryConfig.xsodata/",
				"type": "OData",
				"settings": {
					"localUri": "localService/readCtryConfig.xsodata/metadata.xml"
				}
			},
			"helpLinks.xsodata": {
				"uri": "/XSA_HTTP_ACCRUAL/xsodata/helpLinks.xsodata/",
				"type": "OData",
				"settings": {
					"localUri": "localService/helpLinks.xsodata/metadata.xml"
				}
			},
			"langdrop.xsodata": {
				"uri": "/XSA_HTTP_ACCRUAL/xsodata/langdrop.xsodata/",
				"type": "OData",
				"settings": {
					"localUri": "localService/langdrop.xsodata/metadata.xml"
				}
			},
			"videolinks.xsodata": {
				"uri": "/XSA_HTTP_ACCRUAL/xsodata/videolinks.xsodata/",
				"type": "OData",
				"settings": {
					"localUri": "localService/videolinks.xsodata/metadata.xml"
				}
			}
		},
		"crossNavigation": {
			"inbounds": {
				"intent1": {
					"signature": {
						"parameters": {},
						"additionalParameters": "allowed"
					},
					"semanticObject": "ConfigTile",
					"action": "read",
					"title": "Configuration",
					"icon": "sap-icon://action-settings"
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": false,
		"rootView": {
			"viewName": "com.takeda.Accrual_UI5.Accrual_Ctry.view.Main",
			"type": "XML",
			"async": true,
			"id": "View1"
		},
		"dependencies": {
			"minUI5Version": "1.65.6",
			"libs": {
				"sap.ui.layout": {},
				"sap.ui.core": {},
				"sap.m": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.takeda.Accrual_UI5.Accrual_Ctry.i18n.i18n"
				}
			},
			"config": {
				"type": "sap.ui.model.odata.v2.ODataModel",
				"settings": {
					"defaultOperationMode": "Server",
					"defaultBindingMode": "OneWay",
					"defaultCountMode": "Request"
				},
				"dataSource": "readConfigValues.xsodata",
				"preload": true
			},
			"userRoleModel": {
				"type": "sap.ui.model.odata.v2.ODataModel",
				"settings": {
					"defaultOperationMode": "Server",
					"defaultBindingMode": "OneWay",
					"defaultCountMode": "Request"
				},
				"dataSource": "userRole.xsodata",
				"preload": true
			},
			"thresholdModel": {
				"type": "sap.ui.model.odata.v2.ODataModel",
				"settings": {
					"defaultOperationMode": "Server",
					"defaultBindingMode": "OneWay",
					"defaultCountMode": "Request"
				},
				"dataSource": "readThreshold.xsodata",
				"preload": true
			},
			"ctryConfig": {
				"type": "sap.ui.model.odata.v2.ODataModel",
				"settings": {
					"defaultOperationMode": "Server",
					"defaultBindingMode": "OneWay",
					"defaultCountMode": "Request"
				},
				"dataSource": "readCtryConfig.xsodata",
				"preload": true
			},
			"linksModel": {
				"type": "sap.ui.model.odata.v2.ODataModel",
				"settings": {
					"defaultOperationMode": "Server",
					"defaultBindingMode": "OneWay",
					"defaultCountMode": "Request"
				},
				"dataSource": "helpLinks.xsodata",
				"preload": true
			},
			"langModel": {
				"type": "sap.ui.model.odata.v2.ODataModel",
				"settings": {
					"defaultOperationMode": "Server",
					"defaultBindingMode": "TwoWay",
					"defaultCountMode": "Request"
				},
				"dataSource": "langdrop.xsodata",
				"preload": true
			},
			"videolinkModel": {
				"type": "sap.ui.model.odata.v2.ODataModel",
				"settings": {
					"defaultOperationMode": "Server",
					"defaultBindingMode": "OneWay",
					"defaultCountMode": "Request"
				},
				"dataSource": "videolinks.xsodata",
				"preload": true
			}
		},
		"resources": {
			"css": [
				{
					"uri": "css/style.css"
				}
			]
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"viewType": "XML",
				"async": true,
				"viewPath": "com.takeda.Accrual_UI5.Accrual_Ctry.view",
				"controlAggregation": "pages",
				"controlId": "app",
				"clearControlAggregation": false
			},
			"routes": [
				{
					"name": "TargetView1",
					"pattern": "RouteView1",
					"target": [
						"TargetView1"
					]
				}
			],
			"targets": {
				"TargetView1": {
					"viewType": "XML",
					"transition": "slide",
					"clearControlAggregation": false,
					"viewId": "View1",
					"viewName": "View1"
				}
			}
		}
	},
	"sap.platform.cf": {
		"oAuthScopes": [
			"$XSAPPNAME.admin"
		]
	}
}