<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:grid="sap.ui.layout.cssgrid"
	xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" class="sapUiSizeCompact" xmlns:html="http://www.w3.org/1999/xhtml">
	<Dialog title="Create Links Configuration" contentWidth="690px" class="dialog" horizontalScrolling="false" id="videolinkCreate">
		<beginButton>
			<Button text="Cancel" press="onCancel" class="cancelbtn"/>
		</beginButton>
		<endButton>
			<Button text="Save" type="Reject" press="onSaveCreateVideoLink" class="savebtn"/>
		</endButton>
		<f:SimpleForm id="CreateVideoLink" layout="ColumnLayout" columnsM="1" columnsL="1" columnsXL="1" adjustLabelSpan="false">
			<f:content>
				<Label text="{i18n>role}"/>
				<Input placeholder="{i18n>role}" required="true" width="290px" maxLength="50" class="select" id="videolinkRoleCreate"/>
				<Label text="{i18n>linkid}"/>
				<Input placeholder="{i18n>linkid}" required="true" width="290px" maxLength="50" class="select" id="videolinkIdCreate"/>
				<Label text="{i18n>lang}"/>
				<ComboBox selectedKey="" placeholder="{i18n>lang}" required="true" width="290px" id="videolinkLangCreate" items="{languageDataModel>/}">
					<core:Item key="{languageDataModel>LANG_CODE}" text="{languageDataModel>LANG_CODE}-{languageDataModel>LANGUAGE}"/>
				</ComboBox>
				<Label text="{i18n>reftopic}"/>
				<Input placeholder="{i18n>reftopic}" required="true" width="290px" maxLength="50" class="select" id="videolinkDescCreate"/>
				<Label text="{i18n>reflink}"/>
				<Input placeholder="{i18n>reflink}" required="true" width="290px" maxLength="255" class="select" id="videoLinkCreate"/>
			</f:content>
		</f:SimpleForm>
	</Dialog>
</core:FragmentDefinition>