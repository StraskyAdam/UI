<core:FragmentDefinition xmlns:m="sap.m" xmlns="sap.ui.table" xmlns:u="sap.ui.unified" xmlns:core="sap.ui.core">
	<m:OverflowToolbar>
		<!--<m:SearchField liveChange="onSearchCountryConfig" placeholder="Search" width="32%"/>-->
		<m:ToolbarSpacer width="52.5%"/>
		<m:Button id="buttonV4" text="Create" type="Reject" press="onPressCreateVideoLink" class="savebtn"/>
		<m:Button id="buttonV2" text="Change" press="onPressChangeVideoLink" class="cancelbtn"/>
		<m:Button id="buttonV5" text="Delete" press="onPressDeleteVideoLink" class="cancelbtn"/>
	</m:OverflowToolbar>
	<Table rows="{path: '/results'}" id="videoTable" selectionMode="Single" ariaLabelledBy="title" rowSelectionChange="videoactionLink">
		<columns>
			<Column width="10rem">
				<m:Label text="{i18n>role}" design="Bold"/>
				<template>
					<m:Text text="{ROLE}" wrapping="false"/>
				</template>
			</Column>
			<Column width="14rem">
				<m:Label text="{i18n>linkid}" design="Bold"/>
				<template>
					<m:Text text="{VIDEO_ID}" wrapping="false"/>
				</template>
			</Column>
			<Column width="10rem">
				<m:Label text="{i18n>lang}" design="Bold"/>
				<template>
					<m:Text text="{LANGUAGE}" wrapping="false"/>
				</template>
			</Column>
			<Column width="25rem">
				<m:Label text="{i18n>reftopic}" design="Bold"/>
				<template>
					<m:Text text="{VIDEO_DESC}" wrapping="false"/>
				</template>
			</Column>
			<Column width="auto">
				<m:Label text="{i18n>reflink}" design="Bold"/>
				<template>
					<m:Link text="Link" href="{VIDEO_LINK}" target="_blank"/>
				</template>
			</Column>
		</columns>
	</Table>
</core:FragmentDefinition>