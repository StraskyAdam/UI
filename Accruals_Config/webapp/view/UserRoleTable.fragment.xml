<core:FragmentDefinition xmlns:m="sap.m" xmlns="sap.ui.table" xmlns:u="sap.ui.unified" xmlns:core="sap.ui.core">
	<m:OverflowToolbar>
		<m:SearchField liveChange="onSearchUserRoleConfig" placeholder="Search" width="32%"/>
		<m:ToolbarSpacer width="12.5%"/>
		<m:Button id="button6" text="Create" type="Reject" press="onPressUserRoleCreate" class="savebtn"/>
		<m:Button id="button7" text="Change" press="onPressUserRoleChange" class="cancelbtn"/>
		<m:Button id="button8" text="Delete" press="onPressUserRoleDelete" class="cancelbtn"/>
	</m:OverflowToolbar>
	<Table rows="{path: '/'}" id="UserRoleTable" selectionMode="Single" ariaLabelledBy="title" rowSelectionChange="actionUserRole">
		<columns>
			<Column width="auto">
				<m:Label text="Email ID" design="Bold"/>
				<template>
					<m:Text text="{USER_EMAILID}" wrapping="false"/>
				</template>
			</Column>
			<Column width="auto">
				<m:Label text="Management Unit" design="Bold"/>
				<template>
					<m:Text text="{MANAGEMENT_UNIT}" wrapping="false"/>
				</template>
			</Column>
			<Column width="auto">
				<m:Label text="Company Code" design="Bold"/>
				<template>
					<m:Text text="{COMPANY_CODE}" wrapping="false"/>
				</template>
			</Column>
			<Column width="auto">
				<m:Label text="Cost Center" design="Bold"/>
				<template>
					<m:Text text="{COST_CENTER}" wrapping="false"/>
				</template>
			</Column>
			<Column width="auto">
				<m:Label text="Access" design="Bold"/>
				<template>
					<m:Text text="{USER_ACCESS}" wrapping="false"/>
				</template>
			</Column>
			<Column width="auto">
				<m:Label text="User Role" design="Bold"/>
				<template>
					<m:Text text="{USER_ROLE}" wrapping="false"/>
				</template>
			</Column>
		</columns>
	</Table>
</core:FragmentDefinition>