<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" 
	xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" class="sapUiSizeCompact" >
	<Dialog title="User Role Update" contentWidth="690px" class="dialog" horizontalScrolling="false" id="updateUserRoleTable">
		<beginButton>
			<Button text="Cancel" press="onUserRoleUpdateCancel" class="cancelbtn"/>
		</beginButton>
		<endButton>
			<Button text="Save" type="Reject" press="onUserRoleUpdateSave" class="savebtn"/>
		</endButton>
			<f:SimpleForm id="ChangeForm" layout="ColumnLayout" columnsM="1" columnsL="1" columnsXL="1" adjustLabelSpan="false">
				<f:content>
					<Label text="Email ID"/>
					<Input placeholder ="Email ID" 
						   required="true" width="290px"  maxLength="241"
						   class="select" 
						   id="emailIDUpdate" editable="false" />
					
					<Label text="Company Code"/>
					 <Input placeholder ="Company Code" 
						   required="true" width="290px"  maxLength="5000"
						   class="select" 
						   id="companyCodeUpdate" editable="false" />
						   
					<Label text="Management Unit"/>
					 <Input placeholder ="Management Unit" 
						   required="true" width="290px"  maxLength="5000"
						   class="select" 
						   id="managementUnitUpdate" editable="true" />
						   
					<Label text="Cost Center"/>
					 <Input placeholder ="Cost Center" 
						   required="true" width="290px"  maxLength="10000"
						   class="select" 
						   id="costCenterUpdate" editable="true" />
					
					<Label text="Access"/>
					 <Input placeholder ="Access" 
						   required="true" width="290px"  maxLength="5"
						   class="select" 
						   id="accessUpdate"  />
						   
						   
					<Label text="User Role"/>
					 <Input placeholder ="User Role" 
						   required="true" width="290px"  maxLength="10"
						   class="select" 
						   id="userRoleUpdate"  />
						
			
				
				</f:content>
			</f:SimpleForm>
	</Dialog>
</core:FragmentDefinition>