<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" 
	xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" class="sapUiSizeCompact" >
	<Dialog title="Change Configuration" contentWidth="690px" class="dialog" horizontalScrolling="false" id="updateConfigTable">
		<beginButton>
			<Button text="Cancel" press="onConfigCancelUpdate" class="cancelbtn"/>
		</beginButton>
		<endButton>
			<Button text="Save" type="Reject" press="onConfigSaveUpdate" class="savebtn"/>
		</endButton>
			<f:SimpleForm id="ChangeForm" layout="ColumnLayout" columnsM="1" columnsL="1" columnsXL="1" adjustLabelSpan="false">
				<f:content>
					<Label text="Config Name"/>
					<Input placeholder ="Config Name"  width="290px" class="select" id="configNameChange" editable="false"></Input>
					
					<Label text="Config Value"/>
						<Input placeholder ="Config Value"  width="290px" class="select" id="configValueChange" editable="true"></Input>
						
			
				
				</f:content>
			</f:SimpleForm>
	</Dialog>
</core:FragmentDefinition>