<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" 
	xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" class="sapUiSizeCompact" >
	<Dialog title="Change Country Configuration" contentWidth="690px" class="dialog" horizontalScrolling="false" id="updateTable">
		<beginButton>
			<Button text="Cancel" press="onThresholdCancelUpdate" class="cancelbtn"/>
		</beginButton>
		<endButton>
			<Button text="Save" type="Reject" press="onThresholdSaveUpdate" class="savebtn"/>
		</endButton>
			<f:SimpleForm id="ChangeForm" layout="ColumnLayout" columnsM="1" columnsL="1" columnsXL="1" adjustLabelSpan="false">
				<f:content>
					<Label text="Currency"/>
						<Input placeholder ="Currency"  width="290px" class="select" id="currThresholdChange" editable="false"></Input>
					
					<Label text="Country Code"/>
					<Input placeholder ="Country Code"  width="290px" class="select" id="ccodethresholdChange" editable="false"></Input>
					
					
						
					<Label text="Threshold"/>
					<Input placeholder ="Threshold"  width="290px" class="select" id="thresholdChange" editable="true"></Input>
					
				
				</f:content>
			</f:SimpleForm>
	</Dialog>
</core:FragmentDefinition>