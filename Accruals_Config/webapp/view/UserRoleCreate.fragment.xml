<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:grid="sap.ui.layout.cssgrid"
	xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" class="sapUiSizeCompact" xmlns:html="http://www.w3.org/1999/xhtml">
	<Dialog title="User Role Configuration" contentWidth="690px" class="dialog" horizontalScrolling="false" id="formEdit">
		<beginButton>
			<Button text="Cancel" press="onCancel" class="cancelbtn"/>
		</beginButton>
		<endButton>
			<Button text="Save" type="Reject" press="onUserRoleSave" class="savebtn"/>
		</endButton>
			<f:SimpleForm id="ChangeForm" layout="ColumnLayout" columnsM="1" columnsL="1" columnsXL="1" adjustLabelSpan="false">
				<f:content>
					
					<Label text="Email ID"/>
					<Input placeholder ="Email ID" 
						   required="true" width="290px"  maxLength="241"
						   class="select" 
						   id="emailIDCreate"  />
					
					<Label text="Company Code"/>
					 <Input placeholder ="Company Code" 
						   required="true" width="290px"  maxLength="5000"
						   class="select" 
						   id="companyCodeCreate"  />
						   
					<Label text="Management Unit"/>
					 <Input placeholder ="Management Unit" 
						   required="true" width="290px"  maxLength="5000"
						   class="select" 
						   id="managementUnitCreate"  />
						   
					<Label text="Cost Center"/>
					 <Input placeholder ="Cost Center" 
						   required="true" width="290px"  maxLength="10000"
						   class="select" 
						   id="costCenterCreate"  />
					
				
					<Label text="Access"/>
					<ComboBox required="true" id= "accessCreate" width = "290px"
						items="{
							path: 'accessModel>/DataAccess'
						}">
					<core:Item key="{accessModel>Access}" text="{accessModel>Access}" />
					</ComboBox>
					
					
				<Label text="User Role"/>
					<ComboBox required="true" id= "userRoleCreate" width = "290px"
						items="{
							path: 'roleModel>/Roles'
						}">
					<core:Item key="{roleModel>Role}" text="{roleModel>Role}" />
					</ComboBox>
					
					
				</f:content>
			</f:SimpleForm>
	</Dialog>
</core:FragmentDefinition>