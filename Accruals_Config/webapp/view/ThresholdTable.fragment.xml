<core:FragmentDefinition xmlns:m="sap.m" xmlns="sap.ui.table" xmlns:u="sap.ui.unified" xmlns:core="sap.ui.core">
	<m:OverflowToolbar>
		<m:SearchField liveChange="onSearchThresholdConfig" placeholder="Search" width="32%"/>
		<m:ToolbarSpacer width="12.5%"/>
		<m:Button id="button9" text="Create" type="Reject" press="onPressThresholdCreate" class="savebtn"/>
		<m:Button id="button10" text="Change" press="onPressThresholdChange" class="cancelbtn"/>
		<m:Button id="button11" text="Delete" press="onPressThresholdDelete" class="cancelbtn"/>
	</m:OverflowToolbar>
	<Table rows="{path: '/results'}" id="ThresholdTable" selectionMode="Single" ariaLabelledBy="title" rowSelectionChange="actionThreshold">
		<columns>
			<Column width="auto">
				<m:Label text="Currency" design="Bold"/>
				<template>
					<m:Text text="{CURRENCY}" wrapping="false"/>
				</template>
			</Column>
			<Column width="auto">
				<m:Label text="Company Code" design="Bold"/>
				<template>
					<m:Text text="{COMPANY_CODE}" wrapping="false"/>
				</template>
			</Column>
			<Column width="auto">
				<m:Label text="Threshold Amount" design="Bold"/>
				<template>
					<m:Text text="{PO_THRESHOLD}" wrapping="false"/>
				</template>
			</Column>
		</columns>
	</Table>
</core:FragmentDefinition>