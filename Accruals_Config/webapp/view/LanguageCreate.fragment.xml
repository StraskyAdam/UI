<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:grid="sap.ui.layout.cssgrid"
	xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" class="sapUiSizeCompact" xmlns:html="http://www.w3.org/1999/xhtml">
	<Dialog title="Create Languages" contentWidth="690px" class="dialog" horizontalScrolling="false" id="formEdit">
		<beginButton>
			<Button text="Cancel" press="onCancel" class="cancelbtn"/>
		</beginButton>
		<endButton>
			<Button text="Save" type="Reject" press="onLangSave" class="savebtn"/>
		</endButton>
			<f:SimpleForm id="ChangeForm" layout="ColumnLayout" columnsM="1" columnsL="1" columnsXL="1" adjustLabelSpan="false">
				<f:content>
				<Label text="Language Code"/>
					<Input placeholder ="Language Code" 
						   required="true" width="290px"  maxLength="50"
						   class="select" 
						   id="langCodeCreate"  />
					
					<Label text="Language"/>
					 <Input placeholder ="Language" 
						   required="true" width="290px"  maxLength="255"
						   class="select" 
						   id="languageCreate"  />
				
					
				</f:content>
			</f:SimpleForm>
	</Dialog>
</core:FragmentDefinition>