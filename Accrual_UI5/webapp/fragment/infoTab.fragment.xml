<core:FragmentDefinition xmlns="sap.m" xmlns:t="sap.ui.table" xmlns:u="sap.ui.unified" xmlns:layout="sap.ui.layout"
	xmlns:f="sap.ui.layout.form" xmlns:uxap="sap.uxap" xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
	xmlns:smartTable="sap.ui.comp.smarttable" xmlns:core="sap.ui.core" xmlns:sv="sap.ui.comp.smartvariants" class="sapUiSizeCompact">
	<HBox>
		<Text text="{i18n>ThesePOs}" width="52.5rem" class="ThesePOs"/>
	</HBox>
	<VBox>
		<OverflowToolbar design="Transparent" width="100%">
				<ToolbarSpacer/>
				<Button icon="sap-icon://clear-filter" id="clearExclFilter" visible="true" tooltip="{i18n>clearFiltBtnTooltip}" press="onClearExclFilters"/>
		</OverflowToolbar>
		<smartFilterBar:SmartFilterBar beforeVariantFetch="beforeVariantSave" afterVariantLoad="afterVariantLoad" id="smartFilterBarInfo"
			smartVariant="__SVM02" useToolbar="false" entitySet="exclusionPO" liveMode="false" persistencyKey="SmartFilter_Explored2"
			visible="{filterShown}" assignedFiltersChanged="onAssignedFiltersChanged" showFilterConfiguration="false">
			<smartFilterBar:controlConfiguration>
				<smartFilterBar:ControlConfiguration key="FilterField0" index="0" label="{i18n>PoNum}" groupId="_BASIC" width="100px"
					visibleInAdvancedArea="true">
					<smartFilterBar:customControl>
							<MultiInput id="exclServPoNum" 
									valueHelpRequest="onValueHelpDialogPONum"
									showValueHelp="true" 
									showSuggestion="true"
									submit="onPoFilterEnter"
									tokenUpdate = "onTokenUpdate"
									class="sapUiSmallMarginEnd">
					</MultiInput>
					</smartFilterBar:customControl>
				</smartFilterBar:ControlConfiguration>
				<smartFilterBar:ControlConfiguration key="FilterField1" index="1" label="{i18n>lineItem}" groupId="_BASIC" width="100px"
					visibleInAdvancedArea="true">
					<smartFilterBar:customControl>
						<MultiInput id="exclServItemNo" 
									valueHelpRequest="onValueHelpDialogItemNum"
									showValueHelp="true" 
									submit="onItemFilterEnter"
								    tokenUpdate = "onTokenItemUpdate"
									class="sapUiSmallMarginEnd">
						</MultiInput>
					</smartFilterBar:customControl>
				</smartFilterBar:ControlConfiguration>
				<smartFilterBar:ControlConfiguration key="FilterField2" index="2" label="{i18n>supplierName}" groupId="_BASIC" width="100px"
					visibleInAdvancedArea="true">
					<smartFilterBar:customControl>
						<MultiInput id="exclServSuppName" 
									 valueHelpRequest="onValueHelpDialogSupName"
									 showValueHelp="true" 
									 submit="onSuppIDFilterEnter"
								     tokenUpdate = "onTokenSuppIDUpdate"
									 class="sapUiSmallMarginEnd">
						</MultiInput>
					</smartFilterBar:customControl>
				</smartFilterBar:ControlConfiguration>
			</smartFilterBar:controlConfiguration>
			<smartFilterBar:groupConfiguration>
				<smartFilterBar:GroupConfiguration id="datarepfilterinfo" key="DOA_DataReports" index="2" label="Data and Reports" change="onGroupChange"></smartFilterBar:GroupConfiguration>
				<smartFilterBar:GroupConfiguration key="_BASIC" index="1"></smartFilterBar:GroupConfiguration>
			</smartFilterBar:groupConfiguration>
			<!-- layout data used to make the table growing but the filter bar fixed -->
			<smartFilterBar:layoutData>
				<FlexItemData shrinkFactor="0"/>
			</smartFilterBar:layoutData>
		</smartFilterBar:SmartFilterBar>
		<smartTable:SmartTable id="SmartTableBinfo" entitySet="exclusionPO" placeToolbarInTable="false" useExportToExcel="true"
			smartFilterId="smartFilterBarInfo" beforeExport="onBeforeExport" tableType="Table" useTablePersonalisation="true" editable="false"
			useVariantManagement="true" showRowCount="true" header="{i18n>infoHeader}"
			initiallyVisibleFields="EXCHANGERATE_DEC,PONUMBER,SUPPLIERID,SUPPLIERNAME,PSTYPE_TEXT,ITEMNO,GRVALUE,POLINEDESC,POCREATEDAT,PO_PREPARER,POVALUE,WRKSTRTDATE,WRKENDDATE,TOTWRKCOMPAMT ,TOTWRKCOMPPER INVVALUE,POCURRENCY,ZACTIVITYNBR"
			requestAtLeastFields="EXCHANGERATE_DEC,INVVALUE_USD,GRVALUE_USD,POCREATEDAT,POVALUE_USD,EXCHANGERATE,RULETYPE,RULETYPETEXT,EPNUMBER,GLACCOUNT,COSTCENTER,MANAGEUNIT,POOWNER_EMAIL,INTERNALORDER,PURCHASINGUNIT,PROFITCENTER,ASSETID,REGION,ZACTIVITYNBR"
			width="98%" persistencyKey="SmartTableRefApp_Explored" enableAutoBinding="true" editTogglable="false" showFullScreenButton="true"
			beforeRebindTable="onBeforeRebindInfoTable">
			<t:Table id="infoTable" selectionMode="None" ariaLabelledBy="title" enableSelectAll="true" rowSelectionChange="onSelection"
				class="allTables" cellClick="onClickStatus" threshold="100">
				<t:columns>
					<!--Company Code -->
					<t:Column width="6rem" sortProperty="COMPANYCODE" filterProperty="COMPANYCODE" class="whiteColumn">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "COMPANYCODE","columnIndex":"0","leadingProperty": "COMPANYCODE"}'/>
						</t:customData>
						<Label text="{i18n>Companycode}" wrapping="true" class="tileSubText2"/>
						<t:template>
							<Text text="{COMPANYCODE}"/>
						</t:template>
					</t:Column>
					<!--PO Number-->
					<t:Column width="7rem" sortProperty="PONUMBER" filterProperty="PONUMBER">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "PONUMBER","columnIndex":"1","leadingProperty": "PONUMBER"}'/>
						</t:customData>
						<Label text="{i18n>PoNum}" class="tileSubText2"/>
						<t:template>
							<HBox>
								<Link text="{PONUMBER}" press="onPressAribaLink"/>
								<core:Icon class="iconMargin" visible="{path:'POCREATEDAT',formatter:'.formatter.iconFormat'}" src="sap-icon://favorite" size="0.8rem"
									color="#ee1100" tooltip="New"/>
							</HBox>
						</t:template>
					</t:Column>
					<!--Line Item-->
					<t:Column width="6rem" sortProperty="ITEMNO" filterProperty="ITEMNO">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "ITEMNO","columnIndex":"2","leadingProperty": "ITEMNO"}'/>
						</t:customData>
						<Label text="{i18n>lineItem}" class="tileSubText2"/>
						<t:template>
							<Text text="{ITEMNO}"/>
						</t:template>
					</t:Column>
					<!--Supplier Code-->
					<t:Column width="9rem" sortProperty="SUPPLIERID" filterProperty="SUPPLIERID" class="pinkColumn">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "SUPPLIERID","columnIndex":"3","leadingProperty": "SUPPLIERID"}'/>
						</t:customData>
						<Label text="{i18n>supplierID}" class="tileSubText2"/>
						<t:template>
							<Text text="{SUPPLIERID}"/>
						</t:template>
					</t:Column>
					<!--Supplier Name-->
					<t:Column width="9rem" sortProperty="SUPPLIERNAME" filterProperty="SUPPLIERNAME">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "SUPPLIERNAME","columnIndex":"4","leadingProperty": "SUPPLIERNAME"}'/>
						</t:customData>
						<Label text="{i18n>supplierName}" class="tileSubText2"/>
						<t:template>
							<Text text="{SUPPLIERNAME}"/>
						</t:template>
					</t:Column>
					<!--MVP2 changes Start of Code-->
					<!--EXCHANGERATE--> <!-- Changed the EXCHANGERATE- field to new  exchangerate_dec with decimal  -->
					<t:Column width="8rem" hAlign="Right" sortProperty="EXCHANGERATE" filterProperty="EXCHANGERATE">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "EXCHANGERATE","columnIndex":"5","leadingProperty": "EXCHANGERATE"}'/>
						</t:customData>
						<Label text="{i18n>exchangerate}" wrapping="true" class="tileSubText2"/>
						<t:template>
							<Text text="{EXCHANGERATE}"/>
						</t:template>
					</t:Column>
					<!--MVP2 changes End of Code-->
					<!--Document Currency-->
					<t:Column hAlign="Left" width="6rem" sortProperty="POCURRENCY" filterProperty="POCURRENCY">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "POCURRENCY","columnIndex":"6","leadingProperty": "POCURRENCY"}'/>
						</t:customData>
						<Label text="{i18n>docCurr}" wrapping="true" class="tileSubText2"/>
						<t:template>
							<Text text="{POCURRENCY}"/>
						</t:template>
					</t:Column>
					<!--PO Line Description-->
					<t:Column width="9rem" sortProperty="POLINEDESC" filterProperty="POLINEDESC">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "POLINEDESC","columnIndex":"7","leadingProperty": "POLINEDESC"}'/>
						</t:customData>
						<Label text="{i18n>lineDesc}" wrapping="true" class="tileSubText2"/>
						<t:template>
							<Text text="{POLINEDESC}"/>
						</t:template>
					</t:Column>
					<!--PO Value-->
					<t:Column width="9rem" hAlign="Right" sortProperty="POVALUE" filterProperty="POVALUE">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "POVALUE,POCURRENCY","columnIndex":"8","leadingProperty": "POVALUE"}'/>
						</t:customData>
						<Label text="{i18n>POvalue}" textAlign="Right" class="tileSubText2"/>
						<t:template>
							<Text text="{parts:[ 'userModel>/', 'POVALUE', 'POCURRENCY' ], formatter:'.formatter.formatCurrencyWithCode'}"/>
						</t:template>
					</t:Column>
					<!--MVP2 changes Start of Code-->
					<!--POVALUE USD-->
					<t:Column width="9rem" hAlign="Right" sortProperty="POVALUE_USD" filterProperty="POVALUE_USD">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "POVALUE_USD","columnIndex":"9","leadingProperty": "POVALUE_USD"}'/>
						</t:customData>
