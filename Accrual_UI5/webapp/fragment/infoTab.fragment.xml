					<!--GL Account-->
					<t:Column width="8rem" sortProperty="GLACCOUNT" filterProperty="GLACCOUNT"
						visible="{path:'userRoleDataModel>/', formatter:'.formatter.userRoleVisibility'}">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "GLACCOUNT","columnIndex":"26","leadingProperty": "GLACCOUNT"}'/>
						</t:customData>
						<Label text="{i18n>GLAccount}" wrapping="true" class="tileSubText2"/>
						<t:template>
