					<t:Column width="8rem" sortProperty="PROFITCENTER" filterProperty="PROFITCENTER"
						visible="{path:'userRoleDataModel>/', formatter:'.formatter.userRoleVisibility'}">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "PROFITCENTER","columnIndex":"23","leadingProperty": "PROFITCENTER"}'/>
						</t:customData>
						<Label text="{i18n>profitcenter}" wrapping="true" class="tileSubText2"/>
						<t:template>
							<Text text="{path:'PROFITCENTER'}"/>
						</t:template>
					</t:Column>
					<!--PO Owner Email-->
					<t:Column width="12rem" sortProperty="POOWNER_EMAIL" filterProperty="POOWNER_EMAIL">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "POOWNER_EMAIL","columnIndex":"24","leadingProperty": "POOWNER_EMAIL"}'/>
						</t:customData>
						<Label text="{i18n>POowner}" wrapping="true" class="tileSubText2"/>
						<t:template>
							<Text text="{POOWNER_EMAIL}"/>
