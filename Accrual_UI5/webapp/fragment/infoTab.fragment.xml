						<t:template>
							<Text text="{path:'WRKSTRTDATE',formatter:'.formatter.workDateFormat'}"/>
						</t:template>
					</t:Column>
					<!--Service End Date-->
					<t:Column width="9rem" sortProperty="WRKENDDATE" filterProperty="WRKENDDATE">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "WRKENDDATE","columnIndex":"11","leadingProperty": "WRKENDDATE" , "type":"date"}'/>
						</t:customData>
						<Label text="{i18n>WorkEnd}" wrapping="true" class="tileSubText2"/>
						<t:template>
							<Text text="{path:'WRKENDDATE',formatter:'.formatter.workDateFormat'}"/>
						</t:template>
					</t:Column>
					<!--Services Completed Amount-->
					<t:Column width="10rem" hAlign="Right" sortProperty="TOTWRKCOMPAMT" filterProperty="TOTWRKCOMPAMT">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "TOTWRKCOMPAMT,POCURRENCY","columnIndex":"12","leadingProperty": "TOTWRKCOMPAMT"}'/>
						</t:customData>
						<Label text="{i18n>Amount}" textAlign="Right" wrapping="true" class="tileSubText2"/>
						<t:template>
							<Text text="{parts:[ 'userModel>/', 'TOTWRKCOMPAMT', 'POCURRENCY' ], formatter:'.formatter.formatCurrencyWithCode'}"/>
						</t:template>
					</t:Column>
					<!--% Of Services Completed--> <!--TOTWRKCOMPPER is changed to new field totWrkCompPer_char  -->
					<t:Column width="9rem" hAlign="Right" sortProperty="TOTWRKCOMPPER" filterProperty="TOTWRKCOMPPER">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "TOTWRKCOMPPER","columnIndex":"13","leadingProperty": "TOTWRKCOMPPER"}'/>
						</t:customData>
						<Label text="{i18n>percent}" textAlign="Right" wrapping="true" class="tileSubText2"/>
						<t:template>
							<Text text="{parts:[ 'userModel>/', 'TOTWRKCOMPPER' ], formatter:'.formatter.formatPercent'}" textAlign="Right"/>
						</t:template>
					</t:Column>
					<!--Services Completed Amount USD-->
					<t:Column width="10rem" hAlign="Right" sortProperty="TOTWRKCOMPAMT_USD" filterProperty="TOTWRKCOMPAMT_USD">
						<t:customData>
							<core:CustomData key="p13nData"
								value='\{"columnKey": "TOTWRKCOMPAMT_USD,POCURRENCY","columnIndex":"14","leadingProperty": "TOTWRKCOMPAMT_USD"}'/>
						</t:customData>
						<Label text="{i18n>AmountUSD}" textAlign="Right" wrapping="true" class="tileSubText2"/>
						<t:template>
							<Text text="{parts:[ 'userModel>/', 'TOTWRKCOMPAMT_USD'], formatter:'.formatter.formatCurrencyUSD'}"/>
						</t:template>
					</t:Column>
					<!--Goods Receipt-->
					<t:Column width="11rem" hAlign="Right" sortProperty="GRVALUE" filterProperty="GRVALUE">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "GRVALUE","columnIndex":"15","leadingProperty": "GRVALUE"}'/>
						</t:customData>
						<Label text="{i18n>Goods}" textAlign="Right" wrapping="true" class="tileSubText2"/>
						<t:template>
							<Text text="{parts:[ 'userModel>/', 'GRVALUE', 'POCURRENCY' ], formatter:'.formatter.formatCurrencyWithCode'}"/>
						</t:template>
					</t:Column>
					<!--MVP2 changes Start of Code-->
					<!--GRVALUE USD-->
					<t:Column width="8rem" hAlign="Right" sortProperty="GRVALUE_USD" filterProperty="GRVALUE_USD">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "GRVALUE_USD","columnIndex":"16","leadingProperty": "GRVALUE_USD"}'/>
						</t:customData>
						<Label text="{i18n>gr_usd}" textAlign="Right" wrapping="true" class="tileSubText2"/>
						<t:template>
							<Text text="{parts:[ 'userModel>/', 'GRVALUE_USD'], formatter:'.formatter.formatCurrencyUSD'}"/>
						</t:template>
					</t:Column>
					<!--MVP2 changes End of Code-->
					<!--Purchasing Unit-->
					<!--<t:Column width="8rem" sortProperty="PURCHASINGUNIT" filterProperty="PURCHASINGUNIT"-->
					<!--	visible="{path:'userRoleDataModel>/', formatter:'.formatter.userRoleVisibility'}">-->
					<!--	<t:customData>-->
					<!--		<core:CustomData key="p13nData" value='\{"columnKey": "PURCHASINGUNIT","columnIndex":"16","leadingProperty": "PURCHASINGUNIT"}'/>-->
					<!--	</t:customData>-->
					<!--	<Label text="{i18n>purchasingUnit}" wrapping="true" class="tileSubText2"/>-->
					<!--	<t:template>-->
					<!--		<Text text="{path:'PURCHASINGUNIT'}"/>-->
					<!--	</t:template>-->
					<!--</t:Column>-->
					<!--Management Unit-->
					<t:Column width="8rem" sortProperty="MANAGEUNIT" filterProperty="MANAGEUNIT"
						visible="{path:'userRoleDataModel>/', formatter:'.formatter.userRoleVisibility'}">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "MANAGEUNIT","columnIndex":"17","leadingProperty": "MANAGEUNIT"}'/>
						</t:customData>
						<Label text="{i18n>ManageUnit}" wrapping="true" class="tileSubText2"/>
						<t:template>
							<Text text="{path:'MANAGEUNIT'}"/>
						</t:template>
					</t:Column>
					<!--	<t:Column width="9rem" hAlign="Right" sortProperty="INVVALUE" filterProperty="INVVALUE">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "INVVALUE,POCURRENCY","columnIndex":"18","leadingProperty": "INVVALUE"}'/>
						</t:customData>
						<Label text="{i18n>InvoicePO}" textAlign="Right" wrapping="true" class="tileSubText2"/>
						<t:template>
							<Text text="{parts:[ 'userModel>/', 'INVVALUE', 'POCURRENCY' ], formatter:'.formatter.formatCurrencyWithCode'}"/>
						</t:template>
					</t:Column>-->
					<!--Invoice Amount to  Date  -->
					<t:Column width="9rem" hAlign="Right" sortProperty="INVVALUE" filterProperty="INVVALUE">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "INVVALUE,POCURRENCY","columnIndex":"19","leadingProperty": "INVVALUE"}'/>
						</t:customData>
						<Label text="{i18n>Invoice}" textAlign="Right" wrapping="true" class="tileSubText2"/>
						<t:template>
							<Text text="{parts:[ 'userModel>/', 'INVVALUE', 'POCURRENCY' ], formatter:'.formatter.formatCurrencyWithCode'}"/>
						</t:template>
					</t:Column>
					<!--MVP2 changes Start of Code-->
					<!--INVVALUE USD-->
					<t:Column width="8rem" hAlign="Right" sortProperty="INVVALUE_USD" filterProperty="INVVALUE_USD">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "INVVALUE_USD","columnIndex":"20","leadingProperty": "INVVALUE_USD"}'/>
						</t:customData>
						<Label text="{i18n>inv_usd}" textAlign="Right" wrapping="true" class="tileSubText2"/>
						<t:template>
							<Text text="{parts:[ 'userModel>/', 'INVVALUE_USD'], formatter:'.formatter.formatCurrencyUSD'}"/>
						</t:template>
					</t:Column>
					<!--MVP2 changes End of Code-->
					<!--Asset ID-->
					<t:Column width="8rem" sortProperty="ASSETID" filterProperty="ASSETID"
						visible="{path:'userRoleDataModel>/', formatter:'.formatter.userRoleVisibility'}">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "ASSETID","columnIndex":"21","leadingProperty": "ASSETID"}'/>
						</t:customData>
						<Label text="{i18n>assetId}" wrapping="true" class="tileSubText2"/>
						<t:template>
							<Text text="{path:'ASSETID'}"/>
						</t:template>
					</t:Column>
					<!--Internal Order-->
					<t:Column width="8rem" sortProperty="INTERNALORDER" filterProperty="INTERNALORDER"
						visible="{path:'userRoleDataModel>/', formatter:'.formatter.userRoleVisibility'}">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "INTERNALORDER","columnIndex":"22","leadingProperty": "INTERNALORDER"}'/>
						</t:customData>
						<Label text="{i18n>internalorder}" wrapping="true" class="tileSubText2"/>
						<t:template>
							<Text text="{path:'INTERNALORDER'}"/>
