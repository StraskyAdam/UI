						visible="{path:'userRoleDataModel>/', formatter:'.formatter.userRoleVisibility'}">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "COSTCENTER","columnIndex":"27","leadingProperty": "COSTCENTER"}'/>
						</t:customData>
						<Label text="{i18n>CostCenter}" wrapping="true" class="tileSubText2"/>
						<t:template>
							<Text text="{path:'COSTCENTER',formatter:'.formatter.glAccountFormat'}"/>
						</t:template>
					</t:Column>
					<!--Region-->
					<t:Column width="8rem" sortProperty="REGION" filterProperty="REGION"
						visible="{path:'userRoleDataModel>/', formatter:'.formatter.userRoleVisibility'}">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "REGION","columnIndex":"28","leadingProperty": "REGION"}'/>
						</t:customData>
						<Label text="{i18n>region}" wrapping="true" class="tileSubText2"/>
						<t:template>
							<Text text="{path:'REGION'}"/>
						</t:template>
					</t:Column>
					<!--EP Number-->
					<t:Column width="8rem" sortProperty="EPNUMBER" filterProperty="EPNUMBER">
						<t:customData>
							<core:CustomData key="p13nData" value='\{"columnKey": "EPNUMBER","columnIndex":"29","leadingProperty": "EPNUMBER"}'/>
						</t:customData>
						<Label text="{i18n>epnum}" wrapping="true" class="tileSubText2"/>
						<t:template>
