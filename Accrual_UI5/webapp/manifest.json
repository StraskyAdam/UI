				}
			]
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"viewType": "XML",
				"async": true,
				"viewPath": "com.takeda.Accrual_UI5.view",
				"controlAggregation": "pages",
				"controlId": "app",
				"clearControlAggregation": false
			},
			"routes": [
				{
					"name": "App",
					"pattern": "App",
					"titleTarget": "",
					"greedy": false,
					"target": [
						"App"
					]
				},
				{
					"name": "RouteMain",
					"pattern": "RouteMain",
					"target": [
						"TargetMain"
					]
				},
				{
					"name": "BusinessPage",
					"pattern": "BusinessPage",
					"target": "Business"
				},
				{
					"name": "TBSPage",
					"pattern": "TBSPage",
					"target": "TBS"
				}
			],
			"targets": {
				"TargetMain": {
					"viewType": "XML",
					"transition": "slide",
					"clearControlAggregation": false,
					"viewId": "Main",
					"viewName": "Main"
				},
				"Business": {
					"viewType": "XML",
					"viewName": "Business"
				},
				"TBS": {
					"viewType": "XML",
					"viewName": "TBS"
				},
				"App": {
					"viewType": "XML",
					"viewName": "App",
					"viewId": "App"
				}
			}
		}
	},
	"sap.platform.cf": {
		"oAuthScopes": [
			"$XSAPPNAME.write",
			"$XSAPPNAME.admin"
		]
	}
